+def delegation_tag(con, sid):
+    """Etiqueta [TAG] del hijo: 1ª línea del prompt (part texto de role=user más antiguo).
+
+    Devuelve el tag normalizado SIN corchetes, con espacios en vez de '_'/'-'
+    (p.ej. '[VOZ-JORGE]' → 'VOZ JORGE'), o None para que el llamante use
+    session.title. Defensivo: si falta `part`/`message`/columna o el JSON no es
+    válido, devuelve None sin lanzar (fallback al comportamiento actual).
+    """
+    try:
+        row = con.execute(
+            "SELECT p.data FROM part p JOIN message m ON m.id = p.message_id "
+            "WHERE p.session_id=? AND json_extract(m.data,'$.role')='user' "
+            "AND json_extract(p.data,'$.type')='text' "
+            "ORDER BY p.time_created LIMIT 1", (sid,)).fetchone()
+    except sqlite3.Error:
+        return None
+    if not row or not row[0]:
+        return None
+    try:
+        text = json.loads(row[0]).get("text") or ""
+    except (json.JSONDecodeError, TypeError, AttributeError):
+        return None
+    stripped = text.strip()
+    if not stripped:
+        return None
+    first = stripped.splitlines()[0].strip()
+    m = re.match(r"^\[([^\]]+)\]", first)
+    if not m:
+        return None
+    inner = " ".join(m.group(1).replace("_", " ").replace("-", " ").split())
+    return inner
 
 
+def model_name(raw):
+    """Nombre del modelo desde la columna session.model (JSON) — 'big-pickle'.
+
+    Defensivo: si no es JSON válido o falta 'id', devuelve el texto tal cual o None.
+    """
+    if not raw:
+        return None
+    try:
+        return json.loads(raw).get("id") or None
+    except (json.JSONDecodeError, TypeError, AttributeError):
+        return str(raw) if raw else None
+
