*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node / build del frontend
node_modules/
frontend-dist/
dist/
build/

# Docker
.docker/

# Uploads
backend/uploads/
# Runtime PDF store: user documents, not source. Keep out of the repo.
uploads/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Misc
*.tmp
*.temp

# Core dumps. backend/core is a 160 MB gunicorn crash dump from the aarch64
# server: the app died and the kernel dumped its address space. Never source.
core
core.*
*.core

# Install media. The Ubuntu ISO is a 3.8 GB download artifact, not a source
# file; SHA256SUMS only certifies it. Bump the version in the filename instead.
*.iso
SHA256SUMS

# Scratch files from ad-hoc debugging. Named for what they are.
tmp_*.py
untitled.md
snapshot.json

# Raw recording material behind frontend/landing/videos/. The committed mp4s
# are the deliverable; the pilot run and its per-step audio are not.
tools/walkthrough/pilot/
tools/walkthrough/storyboards/

# Release artifacts served from the downloads page. Built locally by the
# portable build scripts and published by deploy/downloads/publish.sh; never
# committed to git (the server holds the real copies).
deploy/downloads/public/*.zip
deploy/downloads/_privado/