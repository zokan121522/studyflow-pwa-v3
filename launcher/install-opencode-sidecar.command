#!/bin/bash
# ---------------------------------------------------------------------------
#  install-opencode-sidecar.command  (macOS)
#
#  Levanta el sidecar local de OpenZen (un `opencode serve` escuchando en
#  127.0.0.1:54321) como SERVICIO del Mac, para que la PWA encuentre su
#  backend de IA sin que el usuario abra nunca una Terminal.
#
#  Sin esto, en macOS nadie arranca `opencode serve` y el log de la app
#  muestra:  "OpenCode connection error: [Errno 61] Connection refused".
#  En Windows lo arranca un boot script que ademas escribe credenciales
#  Basic-auth fijas en ~/.studyflow/opencode_sidecar.env. Aqui hacemos lo
#  mismo: generamos usuario+password UNA vez, los dejamos en ese fichero
#  (el backend los lee via backend/openzen_sidecar.py) y arrancamos el
#  servidor como LaunchAgent.
#
#  Que hace:
#    1. Localiza el binario `opencode` (~/.opencode/bin/opencode o PATH).
#    2. Crea (idempotente) ~/.studyflow/opencode_sidecar.env con
#       OPENCODE_SERVER_URL / OPENCODE_SERVER_USERNAME / OPENCODE_SERVER_PASSWORD
#       (chmod 600). NUNCA pisa la password de un fichero ya existente.
#    3. Escribe ~/Library/LaunchAgents/com.studyflow.opencode-sidecar.plist
#       (RunAtLoad + KeepAlive, credenciales exportadas al proceso).
#    4. Lo carga con launchctl y comprueba que el puerto 54321 responde.
#
#  Uso:
#    install-opencode-sidecar.command              instala y arranca el sidecar
#    install-opencode-sidecar.command --dry-run    imprime lo que haria, NO cambia nada
#    install-opencode-sidecar.command --uninstall  quita el sidecar (para el servicio)
#
#  NOTA: `opencode serve` NO tiene flags de autenticacion (solo --port /
#  --hostname). Exportamos las credenciales en el plist para paridad con
#  Windows y para que el backend pueda mandar el header Basic; las consume
#  el cliente de StudyFlow, no el propio binario.
#
#  Fichero ASCII puro (sin tildes) por seguridad de codepage.
# ---------------------------------------------------------------------------
set -u

OC_LABEL="com.studyflow.opencode-sidecar"
OC_PORT=54321
OC_HOST="127.0.0.1"
OC_URL="http://127.0.0.1:54321"

ENV_DIR="$HOME/.studyflow"
ENV_FILE="$ENV_DIR/opencode_sidecar.env"
PLIST_DIR="$HOME/Library/LaunchAgents"
PLIST="$PLIST_DIR/$OC_LABEL.plist"
LOG_DIR="$HOME/Library/Logs"
LOG_FILE="$LOG_DIR/studyflow-opencode-sidecar.log"
UID_NUM="$(id -u)"

DRY_RUN=0
UNINSTALL=0
for arg in "$@"; do
    case "$arg" in
        --dry-run)   DRY_RUN=1 ;;
        --uninstall) UNINSTALL=1 ;;
        -h|--help)
            sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "ERROR: opcion desconocida: $arg" >&2
            echo "Uso: $(basename "$0") [--dry-run|--uninstall]" >&2
            exit 2
            ;;
    esac
done

# ------------------------------------------------------------------ binary
# Resuelve el binario de opencode: ruta estable primero, luego el PATH.
resolve_binary() {
    if [ -x "$HOME/.opencode/bin/opencode" ]; then
        OC_BIN="$HOME/.opencode/bin/opencode"
        return 0
    fi
    if command -v opencode >/dev/null 2>&1; then
        OC_BIN="$(command -v opencode)"
        return 0
    fi
    return 1
}

if ! resolve_binary; then
    echo "  [X] No encuentro el binario 'opencode'." >&2
    echo "      Buscado en: $HOME/.opencode/bin/opencode  y en el PATH." >&2
    echo "      Instala OpenCode (https://opencode.ai) y vuelve a intentarlo." >&2
    exit 1
fi

# ------------------------------------------------------------------ creds
# Password/usuario aleatorios; se generan UNA vez y se conservan.
rand_hex() {
    local n="$1"
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex $(( (n + 1) / 2 )) | cut -c1-"$n"
    else
        LC_ALL=C tr -dc 'a-f0-9' </dev/urandom | head -c "$n"
    fi
}

# Lee un valor KEY=... de un fichero de entorno (vacio si no esta).
env_value() {
    [ -f "$ENV_FILE" ] || return 0
    sed -n "s/^$1=//p" "$ENV_FILE" | head -1
}

OC_USER="$(env_value OPENCODE_SERVER_USERNAME)"
OC_PASS="$(env_value OPENCODE_SERVER_PASSWORD)"
ENV_EXISTS=0
if [ -f "$ENV_FILE" ]; then ENV_EXISTS=1; fi
# Solo generamos lo que falte -> nunca pisamos una password existente.
[ -n "$OC_USER" ] || OC_USER="studyflow-$(rand_hex 4)"
[ -n "$OC_PASS" ] || OC_PASS="$(rand_hex 32)"

# El contenido exacto del fichero de entorno.
read -r -d '' ENV_BODY <<EOF || true
# OpenZen sidecar credentials (generated by install-opencode-sidecar.command).
# Read by backend/openzen_sidecar.py::apply_sidecar_env().
# Do not edit the password by hand unless you also restart the sidecar.
OPENCODE_SERVER_URL=$OC_URL
OPENCODE_SERVER_USERNAME=$OC_USER
OPENCODE_SERVER_PASSWORD=$OC_PASS
EOF

# El plist completo, en una variable: --dry-run solo lo imprime.
read -r -d '' PLIST_XML <<EOF || true
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$OC_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$OC_BIN</string>
		<string>serve</string>
		<string>--port</string>
		<string>$OC_PORT</string>
		<string>--hostname</string>
		<string>$OC_HOST</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OPENCODE_SERVER_URL</key>
		<string>$OC_URL</string>
		<key>OPENCODE_SERVER_USERNAME</key>
		<string>$OC_USER</string>
		<key>OPENCODE_SERVER_PASSWORD</key>
		<string>$OC_PASS</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>$LOG_FILE</string>
	<key>StandardErrorPath</key>
	<string>$LOG_FILE</string>
</dict>
</plist>
EOF

# ------------------------------------------------------------------ uninstall
if [ "$UNINSTALL" = 1 ]; then
    echo "  Quitando el sidecar de OpenZen ($OC_LABEL)..." >&2
    if [ "$DRY_RUN" = 1 ]; then
        echo "  (dry-run) launchctl bootout gui/$UID_NUM $PLIST" >&2
        echo "  (dry-run) rm -f $PLIST" >&2
        echo "  (dry-run) NO se toca $ENV_FILE (se conservan las credenciales)" >&2
        exit 0
    fi
    launchctl bootout "gui/$UID_NUM" "$PLIST" >/dev/null 2>&1 \
        || launchctl bootout "gui/$UID_NUM/$OC_LABEL" >/dev/null 2>&1 || true
    rm -f "$PLIST"
    echo "  Sidecar descargado. Plist borrado: $PLIST" >&2
    echo "  (Se conserva $ENV_FILE.)" >&2
    exit 0
fi

# ------------------------------------------------------------------ dry-run
if [ "$DRY_RUN" = 1 ]; then
    # La info va a stderr (para poder parsear el plist de stdout) y el plist
    # a stdout, igual que install-autostart.command.
    {
        echo "  [dry-run] Binario  : $OC_BIN"
        echo "  [dry-run] Env file : $ENV_FILE  (chmod 600)"
        echo "  [dry-run] Log      : $LOG_FILE"
        echo "  [dry-run] LaunchAgent: $PLIST  ($OC_LABEL)"
        if [ "$ENV_EXISTS" = 1 ]; then
            echo "  [dry-run] El fichero de entorno ya existe -> se CONSERVA su password."
        else
            echo "  [dry-run] Se generaria este fichero de entorno:"
        fi
        printf '%s\n' "$ENV_BODY"
        echo "  [dry-run] NADA se ha modificado (dry-run)."
    } >&2
    printf '%s\n' "$PLIST_XML"
    exit 0
fi

# ------------------------------------------------------------------ banner
cat <<'BANNER'

  ============================================================
        O P E N Z E N   -   SIDECAR LOCAL (macOS)
  ============================================================

   Vamos a arrancar el servidor local de OpenZen (opencode serve)
   como servicio del Mac, para que la PWA tenga siempre su IA.

BANNER

# ----- 1/4  Fichero de entorno -----
echo "  [1/4] Preparando credenciales ($ENV_FILE)..."
mkdir -p "$ENV_DIR"
if [ "$ENV_EXISTS" = 1 ]; then
    # Reescribimos por si faltaba alguna clave, pero respetando la password.
    ( umask 077; printf '%s\n' "$ENV_BODY" > "$ENV_FILE" )
    echo "        Conservadas las credenciales existentes."
else
    ( umask 077; printf '%s\n' "$ENV_BODY" > "$ENV_FILE" )
    echo "        Credenciales generadas."
fi
chmod 600 "$ENV_FILE"
echo "        Listo (permisos 600)."

# ----- 2/4  Escribir el LaunchAgent -----
echo "  [2/4] Escribiendo el LaunchAgent ($OC_LABEL)..."
mkdir -p "$PLIST_DIR" "$LOG_DIR"
printf '%s\n' "$PLIST_XML" > "$PLIST"
echo "        $PLIST"

# ----- 3/4  Cargar el servicio -----
echo "  [3/4] Cargando el servicio con launchctl..."
launchctl bootout "gui/$UID_NUM" "$PLIST" >/dev/null 2>&1 || true
if ! launchctl bootstrap "gui/$UID_NUM" "$PLIST" 2>/dev/null; then
    launchctl bootout "gui/$UID_NUM/$OC_LABEL" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$UID_NUM" "$PLIST" >/dev/null 2>&1 || true
fi
launchctl enable "gui/$UID_NUM/$OC_LABEL" >/dev/null 2>&1 || true

# ----- 4/4  Verificar que el puerto responde -----
echo "  [4/4] Esperando a que el sidecar responda en $OC_URL ..."
listo=0
intento=0
while [ "$intento" -lt 20 ]; do
    if curl -sS -o /dev/null "$OC_URL" >/dev/null 2>&1; then
        listo=1
        break
    fi
    intento=$((intento + 1))
    sleep 1
done

cat <<EOF

  ============================================================
        ***  OPENZEN SIDECAR INSTALADO  ***
  ============================================================

   Servicio : $OC_LABEL
   Binario  : $OC_BIN
   Endpoint : $OC_URL
   Env      : $ENV_FILE   (chmod 600)
   Log      : $LOG_FILE

   Para comprobarlo:
       launchctl list | grep opencode
       curl -sS $OC_URL

   Para quitarlo:  launcher/install-opencode-sidecar.command --uninstall

EOF
if [ "$listo" = 1 ]; then
    echo "   El sidecar esta respondiendo."
else
    echo "   El sidecar queda instalado; puede tardar unos segundos en responder."
    echo "   Mira el log si no arranca: $LOG_FILE"
fi
echo
